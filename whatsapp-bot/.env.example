# Twilio (WhatsApp Business)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OpenAI
OPENAI_API_KEY=sk-your_openai_key

# Resend (email to dealers - free 100/day)
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=agent@click2trade.com.au
INBOUND_DOMAIN=offers.click2trade.com.au

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key

# AutoGrab (optional - for real valuations)
AUTOGRAB_API_KEY=your_autograb_key

# ── Acquisition pipeline (buying from private sellers) ──
INGEST_API_KEY=long_random_string_for_the_scraping_agent
ADMIN_TOKEN=long_random_string_for_the_dashboard
BUSINESS_NAME=Click2Trade
DEALER_LICENCE=LMCT 00000
SENDER_NAME=Your Name
SENDER_PHONE=04xx xxx xxx
SELLER_FROM_EMAIL=buy@click2trade.com.au
TWILIO_SMS_NUMBER=+61xxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx   # alternative to TWILIO_SMS_NUMBER
MAX_AGE_YEARS=5
MAX_KM=80000
MIN_DISCOUNT_PCT=5
# DATA_DIR=./data   # used when Supabase isn't configured

# ── Dealer portal (/dealer) ──
ADMIN_EMAIL=you@click2trade.com.au        # sign-up alerts and "bidding ended" notices
PUBLIC_URL=https://click2trade.onrender.com  # used in links inside emails
DEALER_FROM_EMAIL=stock@click2trade.com.au
# DISPLAY_TZ=Australia/Sydney

# ── Seller outreach on WhatsApp + follow-ups ──
# WhatsApp only allows a business to message someone first with a Meta-approved template.
# Create two in Twilio → Messaging → Content Template Builder, variables {{1}} first name, {{2}} car, {{3}} business:
#   Intro:     "Hi {{1}}, we saw your {{2}} for sale. {{3}} is a licensed dealer keen to buy it - fast payment, we handle paperwork and pickup. Open to a chat? Reply STOP to opt out"
#   Follow-up: "Hi {{1}}, just following up on your {{2}} - {{3}} is still keen to buy it. Happy to chat? Reply STOP to opt out"
TWILIO_WA_INTRO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WA_FOLLOWUP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FOLLOWUP_HOURS=48   # nudge sellers who haven't replied after this long (business hours only)
MAX_FOLLOWUPS=1
