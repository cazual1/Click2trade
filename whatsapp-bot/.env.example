# Twilio (WhatsApp Business)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OpenAI
OPENAI_API_KEY=sk-your_openai_key

# Resend (email to dealers - free 100/day)
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=agent@click2trade.com.au
INBOUND_DOMAIN=offers.click2trade.com.au

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key

# AutoGrab (optional - for real valuations)
AUTOGRAB_API_KEY=your_autograb_key

# ── Acquisition pipeline (buying from private sellers) ──
INGEST_API_KEY=long_random_string_for_the_scraping_agent
ADMIN_TOKEN=long_random_string_for_the_dashboard
BUSINESS_NAME=Click2Trade
DEALER_LICENCE=LMCT 00000
SENDER_NAME=Your Name
SENDER_PHONE=04xx xxx xxx
SELLER_FROM_EMAIL=buy@click2trade.com.au
TWILIO_SMS_NUMBER=+61xxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx   # alternative to TWILIO_SMS_NUMBER
MAX_AGE_YEARS=5
MAX_KM=80000
MIN_DISCOUNT_PCT=5
